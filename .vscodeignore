# Build inputs — not needed at runtime (esbuild bundles everything into dist/extension.js)
src/**
scripts/**
out/**
test/**

# Intermediate TypeScript compilation output — already bundled into dist/extension.js
dist/chef/**
dist/**/*.d.ts
dist/**/*.d.ts.map

# Node modules — bundled by esbuild, not shipped separately
node_modules/**
!node_modules/libbzip2-wasm/package.json
!node_modules/libbzip2-wasm/dist/libbzip2-wasm.js
!node_modules/@alexaltea/capstone-js/package.json
!node_modules/@alexaltea/capstone-js/dist/capstone.js
!node_modules/@alexaltea/capstone-js/dist/capstone.wasm
!node_modules/@blu3r4y/lzma/package.json
!node_modules/@blu3r4y/lzma/index.js
!node_modules/@blu3r4y/lzma/src/lzma_worker.js
!node_modules/jq-web/package.json
!node_modules/jq-web/jq.js
!node_modules/jq-web/jq.wasm
!node_modules/node-md6/package.json
!node_modules/node-md6/md6.js

# TypeScript config
tsconfig*.json

# Source maps (comment out to keep maps for debugging)
**/*.map

# Dev & CI tooling
.vscode/**
.github/**
.claude/**
.gitignore
.eslintrc*
.prettierrc*

# Misc
report.md
*.vsix

# Assets: ship only the extension icon; demo media is referenced via the repo URL
assets/**
!assets/logo.jpg

# Test reports, coverage and docs
coverage/**
test-report/**
docs/**
notes/**
jest.config.js
eslint.config.mjs
Makefile
typedoc.json
tsconfig.chef.json
tsconfig.json
